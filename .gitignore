# No trailing slash: with one, the pattern matches directories only, and a
# node_modules *symlink* (what a scratch worktree gets) is committed instead.
node_modules
dist/
dist-test/
out/
*.vsix

# Copied from @ordewell/core by scripts/copy-skills.mjs at build time — not source.
packages/vscode/skills/

# Downloaded VS Code build used by the extension integration tests (~320 MB)
.vscode-test/

# Local session state and scratch working notes
.ordewell/
.scratch/

# Agent tooling. `.claude/settings.local.json` records approved command lines
# verbatim, inline environment variables included — it has held a live API key
# before, so this must never be committed. AGENTS.md and CLAUDE.md are
# deliberately NOT ignored: both are written for contributors/new agents and
# ship (CLAUDE.md is the Claude Code entry point).
.claude/
.opencode/
.codegraph/

# Reference repositories (cloned for comparison only)
reference_projects/

# Secrets
.env
.env.local
.env.*.local

# VS Code workspace files contain local absolute paths
*.code-workspace

# Coverage output — regenerated by the test run, and the summaries embed the
# absolute path of whoever produced them.
coverage/

# Python bytecode — regenerated on import, pinned to one interpreter version
__pycache__/
*.py[cod]

# OS noise
.DS_Store
Thumbs.db

*.tsbuildinfo
