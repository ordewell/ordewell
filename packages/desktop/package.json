{
  "name": "@ordewell/desktop",
  "version": "0.13.1",
  "private": true,
  "description": "Ordewell's desktop app: an Electron client of the local daemon.",
  "license": "Apache-2.0",
  "author": "Alessandro Costanzo Ciano",
  "homepage": "https://ordewell.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ordewell/ordewell.git",
    "directory": "packages/desktop"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsup && vite build && node ../../scripts/generate-third-party-notices.mjs desktop",
    "dev": "node scripts/dev.mjs",
    "package": "node scripts/package.mjs",
    "postinstall": "node scripts/ensure-spawn-helper.mjs",
    "lint": "eslint src e2e playwright.config.ts --ext .ts,.tsx",
    "test": "vitest run",
    "test:quick": "vitest run",
    "test:changed": "vitest run --changed --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.e2e.json",
    "test:desktop-e2e": "playwright test -c playwright.config.ts --project acceptance",
    "test:desktop-tour": "playwright test -c playwright.config.ts --project tour"
  },
  "dependencies": {
    "@ordewell/web": "^0.13.1",
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^4.2.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@ordewell/core": "^0.13.1",
    "@ordewell/ui": "^0.13.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^1.67.0",
    "monaco-editor": "^0.57.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "ws": "^8.18.0"
  }
}
