{
  "name": "@ordewell/cli",
  "version": "0.12.0",
  "description": "Ordewell CLI and TUI — plan, run and verify coding-agent tasks from the terminal.",
  "license": "Apache-2.0",
  "author": "Alessandro Costanzo Ciano",
  "homepage": "https://ordewell.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ordewell/ordewell.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ordewell/ordewell/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "orchestration",
    "coding-agent",
    "claude-code",
    "opencode",
    "codex",
    "tui",
    "cli"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/main.js",
  "bin": {
    "ordewell": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "AUTHORS.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/generate-third-party-notices.mjs cli",
    "prepublishOnly": "npm run build",
    "lint": "eslint src --ext .ts",
    "watch": "tsup --watch",
    "test": "vitest run",
    "test:quick": "vitest run --exclude '**/*.e2e.test.ts' --exclude '**/node_modules/**'",
    "test:changed": "vitest run --changed --passWithNoTests --exclude '**/*.e2e.test.ts' --exclude '**/node_modules/**'",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ordewell/core": "^0.12.0",
    "@ordewell/web": "^0.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "string-width": "^7.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  }
}
