{
  "name": "@ordewell/core",
  "version": "0.11.3",
  "description": "Ordewell core — planner, orchestrator, runners and verification engine.",
  "license": "Apache-2.0",
  "author": "Alessandro Costanzo Ciano",
  "homepage": "https://ordewell.ai",
  "bugs": {
    "url": "https://github.com/ordewell/ordewell/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ordewell/ordewell.git",
    "directory": "packages/core"
  },
  "keywords": [
    "ai",
    "agent",
    "orchestration",
    "coding-agent",
    "planner"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./parsing": {
      "types": "./dist/parsing.d.ts",
      "import": "./dist/parsing.mjs",
      "require": "./dist/parsing.js"
    },
    "./plan-utils": {
      "types": "./dist/plan-utils.d.ts",
      "import": "./dist/plan-utils.mjs",
      "require": "./dist/plan-utils.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.mjs",
      "require": "./dist/testing.js"
    }
  },
  "typesVersions": {
    "*": {
      "parsing": [
        "./dist/parsing.d.ts"
      ],
      "plan-utils": [
        "./dist/plan-utils.d.ts"
      ],
      "testing": [
        "./dist/testing.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE",
    "AUTHORS.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/parsing.ts src/testing.ts src/plan-utils.ts --dts --sourcemap --format cjs,esm --clean --tsconfig tsconfig.json",
    "prepublishOnly": "npm run build",
    "watch": "tsup src/index.ts --watch --sourcemap",
    "test": "vitest run",
    "test:quick": "vitest run --exclude '**/*.e2e.test.ts' --exclude '**/GitWorktreeIsolation.test.ts' --exclude '**/node_modules/**'",
    "test:changed": "vitest run --changed --passWithNoTests --exclude '**/*.e2e.test.ts' --exclude '**/GitWorktreeIsolation.test.ts' --exclude '**/node_modules/**'",
    "test:sandbox": "vitest run --no-file-parallelism src/services/sandbox/__tests__/plannerSandbox.e2e.test.ts src/services/sandbox/__tests__/sealedRuns.e2e.test.ts src/services/__tests__/PatchCapture.e2e.test.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "markdown-it": "^14.3.2",
    "openai": "^4.104.0",
    "uuid": "^11.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^25.9.1",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.27.7",
    "tsup": "^8.3.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  }
}
