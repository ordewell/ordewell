# =============================================================================
# Ordewell — Quick Start
# =============================================================================
# Set ONE provider key below. AI_PROVIDER is auto-detected from whichever key is
# present — only set it explicitly if you need to force one.
# `ordewell key` lists every provider and its variable name.

# --- Recommended: OpenRouter (200+ models behind one API key) ---
# Get your key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-your-key-here

# --- Or go direct to a vendor ---
# ANTHROPIC_API_KEY=      # Anthropic          OPENAI_API_KEY=       # OpenAI
# GEMINI_API_KEY=         # Google Gemini      XAI_API_KEY=          # xAI
# DEEPSEEK_API_KEY=       # DeepSeek           GROQ_API_KEY=         # Groq
# MISTRAL_API_KEY=        # Mistral            TOGETHER_API_KEY=     # Together AI
# FIREWORKS_API_KEY=      # Fireworks AI       PERPLEXITY_API_KEY=   # Perplexity
# CEREBRAS_API_KEY=       # Cerebras           DEEPINFRA_API_KEY=    # DeepInfra
# COHERE_API_KEY=         # Cohere             NOVITA_API_KEY=       # Novita AI
# MOONSHOT_API_KEY=       # Moonshot / Kimi    ZHIPU_API_KEY=        # Zhipu / GLM
# DASHSCOPE_API_KEY=      # Alibaba / Qwen     ARK_API_KEY=          # ByteDance / Doubao
# HUNYUAN_API_KEY=        # Tencent Hunyuan    BAICHUAN_API_KEY=     # Baichuan
# MINIMAX_API_KEY=        # MiniMax            YI_API_KEY=           # 01.AI / Yi
# STEPFUN_API_KEY=        # StepFun            SILICONFLOW_API_KEY=  # SiliconFlow

# --- Or any OpenAI-compatible endpoint, including a local one ---
# Setting the base URL is what selects this provider; the key is optional.
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_API_KEY=

# --- Or no key at all: plan on a coding agent you already have installed ---
# AI_PROVIDER=claude-code               # or codex, or opencode

# =============================================================================
# Model Selection
# =============================================================================
# The planner model. It plans and researches but never writes code, so a budget
# model is the default. `ordewell model` lists what the selected provider offers.
# Model IDs and prices change often; for OpenRouter the live list is
# https://openrouter.ai/models

# ORCHESTRATOR_MODEL=deepseek/deepseek-v4-flash
#   Popular alternatives (OpenRouter IDs — use the full provider/model form):
#     anthropic/claude-sonnet-5         — best reasoning
#     moonshot/kimi-k2.6                — strong coding, cheap
#     openai/gpt-5                      — general purpose

# With a coding-agent planner, this must be one of that agent's own model ids
# (e.g. `haiku`), and thinking effort comes from that model's own variants.
# ORDEWELL_PLANNER_EFFORT=low

# --- Gemini path ---
# Models are auto-discovered from the Gemini API — set GEMINI_MODEL only to override.
# GEMINI_MODEL=gemini-2.5-flash

# =============================================================================
# Advanced — only needed for custom setups
# =============================================================================

# Provider selection (auto-detected from which key is set above)
# AI_PROVIDER=openrouter

# OpenRouter base URL (only if using a proxy or self-hosted gateway)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# =============================================================================
# Runners (the coding agents that execute each task)
# =============================================================================
# Comma-separated. The planner assigns one per task from whatever is enabled.
# Unset means none are enabled — the TUI says so on first run, and
# `ordewell runners <id> on` writes this for you.
# ORDEWELL_RUNNERS=claude-code,codex,opencode

# ORDEWELL_MAX_PARALLEL=3               # Max concurrent AI task sessions (1-5)
# ORDEWELL_RESEARCH_ENABLED=true        # Enable codebase research phase
# ORDEWELL_RESEARCH_MAX_STEPS=48        # Max tool calls during research
